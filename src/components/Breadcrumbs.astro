---
interface Props {
  items: [label: string, href?: string][];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map(([label, href], i) => (
      <li>
        {href && i < items.length - 1 ? <a href={href}>{label}</a> : <span aria-current="page">{label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 0; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.03em; text-transform: uppercase; color: var(--text-3); }
  .crumbs li + li::before { content: '/'; margin: 0 10px; color: var(--line-3); }
  .crumbs a { text-decoration: none; color: var(--text-2); }
  .crumbs a:hover { color: var(--ink); text-decoration: underline; }
  .crumbs span { color: var(--ink); }
</style>

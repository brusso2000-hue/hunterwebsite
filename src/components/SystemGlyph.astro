---
// Technical line drawings of each system's working principle.
// Stroke uses currentColor; the "active" element (deposit, arc, stream) is gold.
import type { SystemId } from '../lib/catalog';

interface Props {
  system: SystemId;
  detailed?: boolean;
}
const { system, detailed = false } = Astro.props;
---

{system === 'micro-metallizer' && (
  <svg viewBox="0 0 240 140" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <!-- cable -->
    <path d="M200 8c18 10 20 34-6 38s-44-4-44-4" opacity=".55" />
    <!-- pen body -->
    <g transform="rotate(-38 140 60)">
      <rect x="92" y="52" width="96" height="16" rx="2" />
      <path d="M188 55h8a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3h-8" />
      <path d="M108 52v16M170 52v16" opacity=".5" />
      <path d="M92 55l-14 3v4l14 3" />
      <path d="M78 58l-12 2 12 2" />
    </g>
    <!-- deposit on substrate -->
    <path d="M24 118h192" />
    <path d="M24 118v12h192v-12" opacity=".5" />
    <path d="M60 118c10-6 44-6 58 0" stroke="var(--gold)" stroke-width="2" />
    <path d="M66 118c9-3.5 36-3.5 46 0" stroke="var(--gold)" stroke-width="1.2" opacity=".7" />
    <!-- current -->
    <path d="M89 104l-3 6 5-2-3 6" stroke="var(--gold)" />
    {detailed && (
      <g font-family="IBM Plex Mono, monospace" font-size="7" fill="currentColor" stroke="none" opacity=".7">
        <text x="150" y="112">SUBSTRATE (−)</text>
        <text x="172" y="74">PEN / ANODE (+)</text>
        <text x="24" y="104">DEPOSIT</text>
      </g>
    )}
  </svg>
)}

{system === 'carbitron' && (
  <svg viewBox="0 0 240 140" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <!-- handpiece -->
    <g transform="rotate(-30 150 56)">
      <rect x="110" y="46" width="92" height="22" rx="11" />
      <path d="M124 46v22M188 46v22" opacity=".5" />
      <path d="M110 52l-18 3v4l18 3" />
      <path d="M92 56H70" stroke-width="2" />
      <path d="M202 57h22" opacity=".55" />
    </g>
    <!-- blade -->
    <path d="M18 122h110l52-14H18z" />
    <path d="M128 122l52-14" stroke="var(--gold)" stroke-width="2.2" />
    <!-- arc -->
    <g stroke="var(--gold)">
      <path d="M150 100l-4-8M156 100l2-9M144 104l-8-3M160 104l7-4" />
      <circle cx="151" cy="106" r="2" fill="var(--gold)" />
    </g>
    {detailed && (
      <g font-family="IBM Plex Mono, monospace" font-size="7" fill="currentColor" stroke="none" opacity=".7">
        <text x="170" y="74">WC ELECTRODE</text>
        <text x="18" y="136">CUTTING EDGE</text>
        <text x="168" y="118">HARDENED LAYER</text>
      </g>
    )}
  </svg>
)}

{system === 'micro-jet' && (
  <svg viewBox="0 0 240 140" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <!-- nozzle -->
    <g transform="rotate(-50 150 40)">
      <rect x="118" y="30" width="80" height="20" rx="2" />
      <path d="M118 34l-22 4v4l22 4" />
      <path d="M198 40h26" opacity=".55" />
      <path d="M134 30v20" opacity=".5" />
    </g>
    <!-- stream -->
    <g fill="var(--gold)" stroke="none">
      <circle cx="104" cy="96" r="1.3" /><circle cx="99" cy="102" r="1" /><circle cx="108" cy="103" r="1.1" />
      <circle cx="95" cy="109" r="1.2" /><circle cx="103" cy="110" r="0.9" /><circle cx="111" cy="108" r="1" />
      <circle cx="92" cy="115" r="1" /><circle cx="100" cy="116" r="1.2" /><circle cx="107" cy="116" r="0.9" />
    </g>
    <path d="M110 88l-22 30M114 92l-8 26" stroke="var(--gold)" opacity=".35" stroke-dasharray="2 3" />
    <!-- part with fine features -->
    <path d="M24 120h192" />
    <path d="M60 120v-6h8v6M76 120v-10h4v10M88 120v-6h6v6M124 120v-8h10v8M146 120v-4h20v4" />
    <path d="M86 120h26" stroke="var(--gold)" stroke-width="2" />
    {detailed && (
      <g font-family="IBM Plex Mono, monospace" font-size="7" fill="currentColor" stroke="none" opacity=".7">
        <text x="190" y="50">NOZZLE</text>
        <text x="130" y="98">ABRASIVE STREAM</text>
        <text x="24" y="134">FINE FEATURES</text>
      </g>
    )}
  </svg>
)}

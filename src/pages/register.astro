---
import Base from '../layouts/Base.astro';
import { FORMSPREE_ENDPOINT, SITE } from '../lib/site';
---

<Base
  title="Register Your Plating Pen | Hunter Products Inc."
  description="Register your Micro-Metallizer plating pen to get a reminder before it reaches the end of its shelf life and the certificate for your lot."
  noindex
>
  <div class="banner">
    <div class="wrap banner-in">
      <h1 class="h-1">Register your pen</h1>
      <p class="lede">It takes under a minute, and you get two things back.</p>
      <ul class="why">
        <li>
          <svg class="why-ic" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
          <div>
            <p class="why-h">A reminder before your pen expires</p>
            <p class="why-p">Plating pens have a 12-month shelf life. We email you before yours runs out, so a job never stops for a dead pen.</p>
          </div>
        </li>
        <li>
          <svg class="why-ic" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
          <div>
            <p class="why-h">The certificate for your lot</p>
            <p class="why-p">Sent to your inbox, ready for your quality records.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <section class="section section--tight">
    <div class="wrap">
      <div class="panel">
        <form class="rf" action={FORMSPREE_ENDPOINT} method="POST" data-register-form>
          <div class="rf-status rf-ok" hidden data-ok role="status">
            <p><strong>You're registered.</strong></p>
            <p>We will email your lot certificate and a reminder before your pen expires. Need pens sooner? Call {SITE.phone}.</p>
          </div>
          <div class="rf-status rf-err" hidden data-err role="alert">
            <p><strong>Something went wrong.</strong></p>
            <p>Please email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or call {SITE.phone}.</p>
          </div>

          <div class="field">
            <label for="rf-first">First name *</label>
            <input class="input" id="rf-first" name="first_name" required autocomplete="given-name" />
          </div>
          <div class="field">
            <label for="rf-last">Last name *</label>
            <input class="input" id="rf-last" name="last_name" required autocomplete="family-name" />
          </div>
          <div class="field">
            <label for="rf-email">Work email *</label>
            <input class="input" id="rf-email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="rf-company">Company *</label>
            <input class="input" id="rf-company" name="company" required autocomplete="organization" />
          </div>
          <div class="field rf-full">
            <label for="rf-use">What are you plating?</label>
            <textarea class="textarea" id="rf-use" name="application" placeholder="Optional. It helps us send the right information."></textarea>
          </div>
          <input type="hidden" name="request_type" value="pen_registration" />
          <input type="hidden" name="_subject" value="Pen registration" />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
          <div class="rf-full">
            <button class="btn btn--primary" type="submit" data-submit>Register pen <span class="arrow">→</span></button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .banner { background: var(--bg-2); border-bottom: 1px solid var(--line); padding: 34px 0; }
  .banner-in { display: grid; gap: 14px; }
  .why { list-style: none; margin: 10px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 900px; }
  @media (max-width: 700px) { .why { grid-template-columns: 1fr; gap: 12px; } }
  .why li { display: flex; gap: 14px; align-items: flex-start; background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--ink); padding: 16px 18px; }
  .why-ic { flex: 0 0 auto; margin-top: 2px; color: var(--ink); }
  .why-h { font-size: clamp(18px, 1.6vw, 21px); font-weight: 600; color: var(--ink); line-height: 1.25; }
  .why-p { margin-top: 4px; color: var(--text-2); font-size: 15px; line-height: 1.5; }
  .panel { border: 1px solid var(--line); padding: clamp(20px, 4vw, 44px); max-width: 760px; }
  .rf { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .rf-full { grid-column: 1 / -1; }
  @media (max-width: 560px) { .rf { grid-template-columns: 1fr; } }
  .rf-status { grid-column: 1 / -1; padding: 14px 16px; border-left: 3px solid; background: var(--bg-2); display: grid; gap: 4px; }
  .rf-ok { border-color: var(--ok); }
  .rf-err { border-color: var(--err); }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-register-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const ok = form.querySelector<HTMLElement>('[data-ok]')!;
      const err = form.querySelector<HTMLElement>('[data-err]')!;
      const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
      ok.hidden = err.hidden = true;
      btn.disabled = true;
      try {
        const data = new FormData(form);
        data.set('form_page', location.pathname);
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        ok.hidden = false;
        ok.scrollIntoView({ block: 'center' });
        // Existing customers, not new leads: tracked in Analytics only, not as an Ads conversion.
        const w = window as any;
        if (typeof w.gtag === 'function') w.gtag('event', 'pen_registration');
      } catch {
        err.hidden = false;
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, POLICY } from '../lib/site';

const years = new Date().getFullYear() - SITE.founded;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Hunter Products',
    url: `${SITE.origin}/about/`,
    mainEntity: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.origin,
      foundingDate: String(SITE.founded),
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.street,
        addressLocality: SITE.city,
        addressRegion: SITE.region,
        postalCode: SITE.postal,
        addressCountry: 'US',
      },
      employee: [{ '@type': 'Person', name: 'Karen Russo', jobTitle: 'President' }],
    },
  },
];

const lines = [
  {
    name: 'Micro-Metallizer',
    href: '/systems/micro-metallizer/',
    what: 'Brush plating pens and kits for selective plating of gold, silver, nickel, copper, rhodium and more, with no tank and no masking of the whole part.',
  },
  {
    name: 'Carbitron 300',
    href: '/systems/carbitron-300/',
    what: 'A portable system that deposits tungsten carbide onto tool edges and wear surfaces for added hardness, wear resistance and heat tolerance.',
  },
  {
    name: 'Micro-Jet 200',
    href: '/systems/micro-jet-200/',
    what: 'A precision micro-abrasive blaster for cleaning, deburring and preparing small, delicate parts.',
  },
];

const industries = [
  ['Aerospace & defense', 'Touch-up and repair plating on connectors, housings and components during MRO.'],
  ['Electronics & PCB', 'Selective plating on contacts, edge fingers and test hardware without stripping the board.'],
  ['Medical & dental', 'Hard, wear-resistant edges on instruments and tooling, and repair of plated surfaces.'],
  ['Tooling & manufacturing', 'Longer tool life from carbide-coated cutting edges, punches and dies.'],
];
---

<Base
  title="About Us | Hunter Products Inc."
  description={`Hunter Products has supplied brush plating, tungsten-carbide coating and micro-abrasive equipment from ${SITE.city}, NJ since ${SITE.founded}. Woman-owned, same-day shipping, real application support.`}
  schema={schema}
>
  <div class="banner">
    <div class="wrap banner-in">
      <Breadcrumbs items={[['Home', '/'], ['About']]} />
      <p class="eyebrow">Since {SITE.founded}</p>
      <h1 class="h-1">About Hunter Products</h1>
      <p class="lede">
        For {years} years, Hunter Products has helped engineers and technicians plate, coat and prepare
        parts right where the work is, without sending them out to a plating shop.
      </p>
    </div>
  </div>

  <section class="section section--tight">
    <div class="wrap cols">
      <div class="blk">
        <h2 class="h-2">Our history</h2>
        <div class="prose">
          <p>
            Hunter Products was founded in {SITE.city}, New Jersey in {SITE.founded} to make localized plating practical
            for the shop floor. Instead of a tank line, a technician could carry the process to the part and plate only
            the area that needed it.
          </p>
          <p>
            That idea grew into three product lines that are still the core of the business today. Over five decades
            they have moved from the bench to production floors, repair depots and labs in the United States and around
            the world.
          </p>
        </div>
        <ul class="lines">
          {lines.map((l) => (
            <li>
              <a class="h-3" href={l.href}>{l.name}</a>
              <p>{l.what}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="blk">
        <h2 class="h-2">Who we are</h2>
        <div class="prose">
          <p>
            Hunter Products is a woman-owned, NJ-based company led by <strong>Karen Russo, President</strong>. We are a small
            team, which means the people who answer your call or email are the same people who pack your order and know the
            equipment.
          </p>
        </div>
      </div>

      <div class="blk">
        <h2 class="h-2">Industries we serve</h2>
        <dl class="inds">
          {industries.map(([t, d]) => (
            <div>
              <dt>{t}</dt>
              <dd>{d}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="blk">
        <h2 class="h-2">Why buy direct</h2>
        <ul class="ticks">
          <li>Orders placed by {POLICY.sameDayCutoff} on a business day ship the same day from {SITE.city}.</li>
          <li>Pens, solutions, electrodes and spare parts are stocked here, so consumables are not a waiting game.</li>
          <li>Application help comes from us directly: process sequence, compatibility, and what to expect on your part.</li>
          <li>We ship worldwide and can work on your UPS or FedEx account.</li>
          <li>Purchase orders welcome. Net 30 terms are available to qualified businesses.</li>
          <li>{POLICY.returnDays}-day returns, and we pay return shipping.</li>
        </ul>
      </div>

    </div>
  </section>
</Base>

<style>
  .banner { background: var(--bg-2); border-bottom: 1px solid var(--line); padding: 22px 0 34px; }
  .banner-in { display: grid; gap: 14px; }
  .banner h1 { margin-top: 2px; }
  .cols { display: grid; gap: 48px; max-width: 820px; }
  .blk { display: grid; gap: 16px; }
  .lines { list-style: none; padding: 0; display: grid; gap: 18px; margin-top: 6px; }
  .lines li { border-left: 3px solid var(--gold); padding-left: 16px; display: grid; gap: 4px; }
  .lines a { color: var(--ink); text-decoration: none; }
  .lines a:hover { text-decoration: underline; }
  .lines p { color: var(--text-2); }
  .inds { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 32px; margin: 0; }
  @media (max-width: 640px) { .inds { grid-template-columns: 1fr; } }
  .inds dt { font-weight: 600; color: var(--ink); }
  .inds dd { margin: 4px 0 0; color: var(--text-2); }
</style>

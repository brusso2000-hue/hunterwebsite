---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import SystemGlyph from '../components/SystemGlyph.astro';
import FinishChart from '../components/FinishChart.astro';
import ProductCard from '../components/ProductCard.astro';
import { SYSTEMS, products, byId, bySlug, fmtPrice, productUrl, productsForSystem, typeOf } from '../lib/catalog';
import { APPLICATIONS } from '../lib/applications';
import { photo } from '../lib/photos';
import { SITE, RETURN_POLICY } from '../lib/site';

const address = {
  '@type': 'PostalAddress',
  streetAddress: SITE.street,
  addressLocality: SITE.city,
  addressRegion: SITE.region,
  postalCode: SITE.postal,
  addressCountry: 'US',
};
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.shortName, alternateName: SITE.name, url: SITE.origin },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.origin,
    logo: `${SITE.origin}/img/brand/hunter-logo.png`,
    description: 'Manufacturer of brush plating (selective electroplating) pens, Carbitron tungsten-carbide coating systems, and Micro-Jet micro-abrasive blasters since 1970.',
    foundingDate: String(SITE.founded),
    address,
    contactPoint: { '@type': 'ContactPoint', telephone: '+1-908-526-8440', email: SITE.email, contactType: 'sales', availableLanguage: 'English' },
    hasMerchantReturnPolicy: RETURN_POLICY,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: SITE.name,
    url: SITE.origin,
    telephone: '+1-908-526-8440',
    email: SITE.email,
    address,
    openingHours: 'Mo-Fr 09:00-17:00',
  },
];

const mm = SYSTEMS.find((x) => x.id === 'micro-metallizer')!;
const mmPoints = [
  'Variable DC power supply, 110V or 220V',
  '12 finishes incl. gold, nickel, tin, silver, rhodium',
  'Standard and heavy-duty pen cartridges',
  'No tank, bath or plating-waste handling',
];
const kits = products.filter((p) => typeOf(p) === 'kit');
const kitSpec = (p: (typeof kits)[number], key: string) => p.specs.find(([k]) => k === key)?.[1] ?? '';

// Hunter's other two systems — shown in their own section so the page stays about brush plating.
const otherBlurb: Record<string, string> = {
  carbitron: 'Tungsten-carbide deposition that hardens cutting edges and wear surfaces on surgical, dental and industrial tools.',
  'micro-jet': 'Controlled micro-abrasive blasting for cleaning, etching and surface prep on fine or delicate parts.',
};
const otherSystems = SYSTEMS.filter((x) => x.id !== 'micro-metallizer').map((x) => ({
  ...x,
  blurb: otherBlurb[x.id],
  from: Math.min(...productsForSystem(x.id).filter((p) => typeOf(p) === 'system').map((p) => p.price)),
}));

const featured = ['PL-1002', 'PL-1003', 'PL-1006', 'PL-1012'].map(byId);

const electronics = APPLICATIONS.find((a) => a.focus === 'core')!;
const electronicsKit = bySlug('contact-repair-kit');
const electronicsPens = ['tin-plating-pen', 'gold-24k-plating-pen', 'nickel-plating-pen', 'palladium-plating-pen'].map(bySlug);
const growth = APPLICATIONS.find((a) => a.focus === 'growth')!;
const others = APPLICATIONS.filter((a) => !a.focus);

const steps = [
  { n: '01', title: 'Clean & degrease', text: 'Absorbent/degreaser pen removes oils and oxides from the work area. Stainless steel takes its own degreaser.', slot: photo('process-clean') },
  { n: '02', title: 'Strike & underlayer', text: 'A copper flash and nickel underlayer build a compatible base on substrates that need one.', slot: photo('process-plate') },
  { n: '03', title: 'Plate the finish', text: 'Brush the final deposit — gold, rhodium, silver, tin — only where the part needs it.', slot: photo('process-finish') },
];
---

<Base
  title="Brush Plating for PCB, Connector & Contact Repair | Hunter Products Inc."
  description="Selective brush plating systems for electronics: gold, nickel, tin and palladium on PCB pads, edge connectors and contacts — no tanks. Micro-Metallizer, Carbitron 300, Micro-Jet 200. Since 1970."
  schema={schema}
>
  <script is:inline>
    // Old single-page anchors → new pages
    ({ '#contact': '/contact/#quote', '#products': '/store/', '#b2b': '/contact/#quote' })[location.hash] &&
      location.replace(({ '#contact': '/contact/#quote', '#products': '/store/', '#b2b': '/contact/#quote' })[location.hash]);
  </script>
  <!-- ─── Hero ─────────────────────────────────────────── -->
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="eyebrow">Brush plating · Selective plating · Since {SITE.founded}</p>
        <h1 class="h-display">Compact, convenient <span class="hero-dim">selective plating.</span></h1>
        <p class="lede">
          Portable brush plating for electronics and beyond. Restore gold on connector pins, re-tin oxidized PCB
          pads and plate contacts exactly where they need it — at the bench or on the line, without tanks, masking
          or disassembly.
        </p>
        <div class="hero-ctas">
          <a class="btn btn--primary" href="#systems">Explore systems <span class="arrow">→</span></a>
          <a class="btn" href="/contact/?topic=technical#quote">Ask an application engineer</a>
        </div>
      </div>
      <div class="hero-media">
        <Photo photo={photo('home-hero')} aspect="5 / 4" eager caption="Fig. 1 — Micro-Metallizer brush plating: pen (+) · workpiece (−) · deposit" />
      </div>
    </div>
    <div class="wrap">
      <dl class="stats">
        <div><dt>Established</dt><dd>{SITE.founded}</dd></div>
        <div><dt>Plating finishes</dt><dd>12</dd></div>
        <div><dt>Pen operation</dt><dd>DC · portable</dd></div>
        <div><dt>Tanks required</dt><dd>0</dd></div>
      </dl>
    </div>
  </section>

  <!-- ─── How brush plating works (explainer + sequence) ─ -->
  <section class="section section--alt">
    <div class="wrap bp">
      <div>
        <p class="eyebrow">How it works</p>
        <h2 class="h-1 bp-title">What is brush plating?</h2>
        <div class="prose">
          <p>
            Brush plating — also called selective or spot plating — is electroplating without the tank. The plating
            solution is held in an absorbent tip connected to the positive lead of a DC power supply; the part is
            connected to the negative. Wherever the tip touches, metal is deposited.
          </p>
          <p>
            Because only the work area is plated, there is no immersion, no masking of the whole part and no need to
            strip an assembly down. The Micro-Metallizer puts this in a self-contained, disposable pen cartridge.
          </p>
        </div>
      </div>
      <div class="bp-compare">
        <table class="spec cmp">
          <thead>
            <tr><th></th><th scope="col">Tank plating</th><th scope="col">Brush plating</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Area plated</th><td>Entire immersed part</td><td>Only the work area</td></tr>
            <tr><th scope="row">Disassembly</th><td>Part removed and masked</td><td>Plate in place</td></tr>
            <tr><th scope="row">Where</th><td>Plating line</td><td>Bench or field</td></tr>
            <tr><th scope="row">Solution</th><td>Open bath to maintain</td><td>Sealed pen cartridge</td></tr>
            <tr><th scope="row">Waste</th><td>Bath disposal</td><td>No bath to dispose</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="wrap seq">
      <div class="seq-head">
        <h3 class="h-3 marked">A typical Micro-Metallizer sequence</h3>
        <p>Each step is a separate pen on the same power supply. Swap the cartridge, keep working.</p>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <Photo photo={s.slot} aspect="4 / 3" />
            <p class="mono step-n">Step {s.n}</p>
            <h3 class="h-3">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── The Micro-Metallizer system ───────────────────── -->
  <section class="section" id="systems">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">The system</p>
          <h2 class="h-1">The Micro-Metallizer brush plating system.</h2>
        </div>
        <a class="link" href={mm.href}>System details <span class="arrow">→</span></a>
      </div>

      <article class="sys">
        <Photo photo={photo('system-micro-metallizer')} aspect="16 / 11" />
        <div class="sys-body">
          <p class="mono sys-idx">{mm.process}</p>
          <p class="sys-sum">{mm.summary}</p>
          <ul class="ticks">{mmPoints.map((pt) => <li>{pt}</li>)}</ul>
          <div class="sys-ctas">
            <a class="btn btn--primary btn--sm" href={mm.href}>System details <span class="arrow">→</span></a>
            <a class="btn btn--sm" href="/store/?line=micro-metallizer">Shop pens &amp; kits</a>
          </div>
        </div>
      </article>

      <div class="kits-head">
        <h3 class="h-3 marked">Kit configurations</h3>
        <p class="mono">Each kit includes the power supply and connector cables</p>
      </div>
      <div class="kits">
        {kits.map((k) => (
          <a class="kit" href={productUrl(k)}>
            <span class="sku">{k.sku}</span>
            <span class="kit-name">{k.name}</span>
            <span class="kit-pens">{kitSpec(k, 'Pens Included')}</span>
            <span class="kit-price">{fmtPrice(k.price)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Industries (electronics-led) ──────────────────── -->
  <section class="section section--alt" id="industries">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Industries</p>
          <h2 class="h-1">Proven in electronics. <span class="hero-dim">Built for aerospace, medical and beyond.</span></h2>
        </div>
        <a class="link" href="/applications-electroplating/">All applications <span class="arrow">→</span></a>
      </div>
      <div class="elx" id="electronics">
    <div class="elx-in">
      <div class="elx-copy">
        <p class="eyebrow">Electronics &amp; PCB</p>
        <h3 class="h-2">The standard for contact and PCB rework.</h3>
        <p class="lede">
          Electronics manufacturers and rework technicians rely on the Micro-Metallizer for precise, localized plating. The pen tip plates a single
          pad, pin or finger without bridging its neighbors or contaminating the board.
        </p>
        <ul class="ticks elx-ticks">
          {electronics.workflows.map((w) => <li>{w}</li>)}
        </ul>
        <div class="hero-ctas">
          <a class="btn btn--primary" href={`/applications-electroplating/#${electronics.id}`}>Electronics applications <span class="arrow">→</span></a>
          <a class="btn" href="/contact/?topic=technical#quote">Discuss your board or connector</a>
        </div>
      </div>
      <div class="elx-side">
        <Photo photo={photo('app-electronics-pcb')} aspect="3 / 2" />
        <a class="elx-kit" href={productUrl(electronicsKit)}>
          <span class="mono elx-kit-tag">Recommended starting kit</span>
          <span class="elx-kit-name">{electronicsKit.name}</span>
          <span class="elx-kit-desc">{electronicsKit.description}</span>
          <span class="elx-kit-price">{fmtPrice(electronicsKit.price)} <span class="sku">{electronicsKit.sku}</span></span>
        </a>
        <div class="elx-pens">
          {electronicsPens.map((p) => (
            <a href={productUrl(p)}>
              <span>{p.name.replace(' Plating Pen', '')}</span>
              <span class="mono">{fmtPrice(p.price)}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
      </div>
      <a class="growth" href={`/applications-electroplating/#${growth.id}`}>
        <span class="app-code mono">{growth.code}</span>
        <div class="growth-copy">
          <h3 class="h-3">{growth.label}</h3>
          <p>{growth.lede} The same pen workflow our electronics customers rely on — applied to aircraft connectors, avionics contacts, fasteners and fittings.</p>
        </div>
        <span class="link">Discuss an aerospace application <span class="arrow">→</span></span>
      </a>
      <div class="apps">
        {others.map((a) => (
          <a class="app" href={`/applications-electroplating/#${a.id}`}>
            <span class="app-code mono">{a.code}</span>
            <h3 class="h-3">{a.label}</h3>
            <p>{a.lede}</p>
            <span class="app-sys mono">{a.systems.map((id) => SYSTEMS.find((s) => s.id === id)!.name).join(' · ')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Finish chart ─────────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Specify</p>
          <h2 class="h-1">Finishes, substrates &amp; underlayers.</h2>
          <p class="lede">Pick the deposit, check the substrate, see what prep it needs — then order the pen.</p>
        </div>
        <a class="link" href="/systems/micro-metallizer/">Micro-Metallizer system <span class="arrow">→</span></a>
      </div>
      <FinishChart compact />
    </div>
  </section>

  <!-- ─── Featured products ────────────────────────────── -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Order</p>
          <h2 class="h-1">Most-ordered products, direct from the manufacturer.</h2>
        </div>
        <a class="link" href="/store/">Shop all products <span class="arrow">→</span></a>
      </div>
      <div class="feat">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- ─── Also from Hunter: Carbitron & Micro-Jet ───────── -->
  <section class="section section--tight" id="other-systems">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Also from Hunter</p>
        <h2 class="h-2">Beyond plating: coating and surface prep.</h2>
      </div>
      <div class="also">
        {otherSystems.map((x) => (
          <a class="also-card" href={x.href}>
            <span class="also-glyph"><SystemGlyph system={x.id} /></span>
            <span class="also-body">
              <span class="mono also-proc">{x.process}</span>
              <span class="also-name">{x.name}</span>
              <span class="also-sum">{x.blurb}</span>
              <span class="also-foot">
                <span class="also-price">From {fmtPrice(x.from)}</span>
                <span class="link">System details <span class="arrow">→</span></span>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Company / resources ──────────────────────────── -->
  <section class="section" id="about">
    <div class="wrap about">
      <div>
        <p class="eyebrow">Hunter Products Inc.</p>
        <h2 class="h-1">Five decades of selective plating.</h2>
        <div class="prose">
          <p>
            Hunter Products has designed and supported localized plating and surface-treatment equipment
            from {SITE.city}, New Jersey since {SITE.founded}. We invented the Carbitron diamond-dusting platform and
            continue to build the Micro-Metallizer line used in aerospace MRO, electronics rework and medical instrument
            repair.
          </p>
          <p>Every order ships direct from our facility, and every question is answered by people who build the equipment.</p>
        </div>
      </div>
      <div class="res">
        <a class="res-item" href="/resources/">
          <span class="mono">PDF</span>
          <span><strong>Micro-Metallizer catalog</strong><br />Every pen, kit and process sequence.</span>
        </a>
        <a class="res-item" href="/resources/">
          <span class="mono">PDF</span>
          <span><strong>Carbitron 300 brochure</strong><br />Specifications and operating guidance.</span>
        </a>
        <a class="res-item" href="/contact/?topic=sds#quote">
          <span class="mono">SDS</span>
          <span><strong>Safety data sheets</strong><br />Request current SDS for any solution.</span>
        </a>
        <a class="res-item" href="/contact/?topic=technical#quote">
          <span class="mono">Q&amp;A</span>
          <span><strong>Application support</strong><br />Sequencing, compatibility, thickness.</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(40px, 6vw, 80px) 0 0; border-bottom: 1px solid var(--line); background: linear-gradient(180deg, var(--bg-2), #fff 70%); }
  .hero-in { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  @media (max-width: 920px) { .hero-in { grid-template-columns: 1fr; } }
  .hero-copy { display: grid; gap: 22px; }
  .hero-dim { color: var(--brand); }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: clamp(40px, 5vw, 64px); border-top: 1px solid var(--line); }
  .stats > div { padding: 22px 20px 26px 0; border-right: 1px solid var(--line); }
  .stats > div + div { padding-left: 20px; }
  .stats > div:last-child { border-right: 0; }
  .stats dt { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
  .stats dd { margin: 6px 0 0; font-stretch: 108%; font-weight: 650; font-size: clamp(22px, 2.4vw, 30px); color: var(--ink); letter-spacing: -0.02em; }
  @media (max-width: 700px) {
    .stats { grid-template-columns: 1fr 1fr; }
    .stats > div:nth-child(2) { border-right: 0; }
    .stats > div:nth-child(3) { padding-left: 0; }
    .stats > div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }

  .bp { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  @media (max-width: 920px) { .bp { grid-template-columns: 1fr; } }
  .bp-title { margin: 16px 0 22px; }
  .cmp thead th { background: var(--brand-deep); color: #fff; font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; padding: 12px 16px; text-align: left; }
  .cmp thead th:first-child { background: var(--brand-deep); }
  .cmp td:last-child { color: var(--ink); font-weight: 550; background: var(--brand-wash); }
  .cmp { background: #fff; }

  .sys { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(28px, 4vw, 56px); align-items: center; }
  @media (max-width: 860px) { .sys { grid-template-columns: 1fr; } }
  .sys-body { display: grid; gap: 16px; }
  .sys-idx { color: var(--brand); }
  .sys-sum { color: var(--text-2); max-width: 58ch; }
  .sys-ctas { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .sys-sum { font-size: 17px; }

  .kits-head { display: flex; justify-content: space-between; align-items: end; gap: 12px 24px; flex-wrap: wrap; margin: clamp(48px, 6vw, 72px) 0 20px; }
  .kits-head .mono { font-size: 11px; color: var(--text-3); }
  .kits { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  @media (max-width: 1000px) { .kits { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .kits { grid-template-columns: 1fr; } }
  .kit { display: flex; flex-direction: column; gap: 6px; padding: 20px; border: 1px solid var(--line); background: #fff; text-decoration: none; transition: border-color 0.18s, background 0.18s; }
  .kit:hover { border-color: var(--brand); background: var(--brand-wash); }
  .kit-name { font-stretch: 105%; font-weight: 650; font-size: 18px; color: var(--ink); }
  .kit-pens { font-size: 14px; color: var(--text-2); line-height: 1.45; }
  .kit-price { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); font-family: var(--mono); font-weight: 500; font-size: 17px; color: var(--ink); }

  .also { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 860px) { .also { grid-template-columns: 1fr; } }
  .also-card { display: grid; grid-template-columns: 180px 1fr; border: 1px solid var(--line); background: #fff; text-decoration: none; transition: border-color 0.18s; }
  .also-card:hover { border-color: var(--brand); }
  @media (max-width: 520px) { .also-card { grid-template-columns: 1fr; } }
  .also-glyph { background: var(--bg-2); border-right: 1px solid var(--line); display: grid; place-items: center; padding: 16px; color: var(--brand-dk); }
  .also-glyph :global(svg) { width: 100%; height: auto; }
  .also-body { display: flex; flex-direction: column; gap: 6px; padding: 20px 22px; }
  .also-proc { font-size: 10.5px; color: var(--brand); }
  .also-name { font-stretch: 106%; font-weight: 650; font-size: 20px; color: var(--ink); }
  .also-sum { font-size: 14.5px; color: var(--text-2); line-height: 1.5; }
  .also-foot { margin-top: auto; padding-top: 12px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .also-price { font-family: var(--mono); font-size: 14px; font-weight: 500; color: var(--ink); }

  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; counter-reset: s; }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; } }
  .step { display: grid; gap: 10px; align-content: start; }
  .step-n { color: var(--gold); margin-top: 8px; }
  .step p:last-child { color: var(--text-2); font-size: 15px; }
  .seq { margin-top: clamp(48px, 6vw, 72px); padding-top: clamp(40px, 5vw, 56px); border-top: 1px solid var(--line-2); }
  .seq-head { display: flex; justify-content: space-between; align-items: end; gap: 12px 32px; flex-wrap: wrap; margin-bottom: 28px; }
  .seq-head p { color: var(--text-2); max-width: 52ch; }

  .apps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  @media (max-width: 1000px) { .apps { grid-template-columns: 1fr 1fr; } }
  .growth { display: grid; grid-template-columns: auto 1fr auto; gap: 20px 28px; align-items: center; margin: 20px 0; padding: clamp(22px, 3vw, 30px); background: var(--navy); color: var(--on-navy-2); text-decoration: none; border-left: 3px solid var(--gold); transition: background 0.18s; }
  .growth:hover { background: var(--navy-2); }
  .growth h3 { color: #fff; margin-bottom: 4px; }
  .growth p { font-size: 15px; max-width: 70ch; }
  .growth .app-code { background: var(--gold); color: var(--navy); margin: 0; }
  .growth .link { color: #fff; }
  @media (max-width: 800px) { .growth { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .apps { grid-template-columns: 1fr; } }
  .app { display: grid; gap: 10px; align-content: start; padding: 26px; background: #fff; text-decoration: none; transition: background 0.18s; }
  .app:hover { background: var(--brand-wash); }
  .app-code { width: 36px; height: 36px; display: grid; place-items: center; background: var(--brand-deep); color: #fff; font-size: 11px; margin-bottom: 6px; }
  .app p { color: var(--text-2); font-size: 15px; }
  .app-sys { font-size: 10.5px; color: var(--brand); margin-top: 6px; }


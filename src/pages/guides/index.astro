---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { GUIDES, guideUrl } from '../../lib/guides';
import { SITE } from '../../lib/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Brush plating guides',
    itemListElement: GUIDES.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.origin}${guideUrl(g.slug)}`, name: g.h1 })),
  },
];
---

<Base
  title="Brush Plating Guides: Connector Pins, PCB Repair, Thickness & Substrates | Hunter Products"
  description="Step-by-step brush plating guides from the maker of the Micro-Metallizer: gold plating connector pins, PCB gold finger repair, re-tinning pads, plating thickness and substrate prep."
  schema={schema}
>
  <div class="banner">
    <div class="wrap banner-in">
      <Breadcrumbs items={[['Home', '/'], ['Guides']]} />
      <h1 class="h-1">Brush plating guides</h1>
      <p class="lede">
        Practical, step-by-step answers for the jobs our customers bring us most, with the voltages, plating times and
        pens straight from our catalog.
      </p>
    </div>
  </div>

  <div class="wrap page">
    <div class="grid">
      {GUIDES.map((g) => (
        <a class="card" href={guideUrl(g.slug)}>
          <span class="mono">{g.eyebrow}</span>
          <h2 class="h-4">{g.h1}</h2>
          <p>{g.lede}</p>
          <span class="go">Read guide <span class="arrow">→</span></span>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .banner { background: var(--bg-2); border-bottom: 1px solid var(--line); padding: 22px 0 34px; }
  .banner-in { display: grid; gap: 14px; }
  .banner h1 { margin-top: 14px; }
  .page { padding-top: 40px; padding-bottom: clamp(64px, 8vw, 104px); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .card { display: flex; flex-direction: column; gap: 10px; padding: 22px; border: 1px solid var(--line); background: #fff; text-decoration: none; transition: border-color 0.18s, box-shadow 0.18s; }
  .card:hover { border-color: var(--line-3); box-shadow: 0 10px 28px rgba(18, 28, 34, 0.07); }
  .card .mono { font-size: 10.5px; color: var(--brand); }
  .card h2 { color: var(--ink); }
  .card p { color: var(--text-2); font-size: 14.5px; line-height: 1.55; }
  .go { margin-top: auto; padding-top: 8px; color: var(--brand-dk); font-size: 14px; font-weight: 550; }
</style>

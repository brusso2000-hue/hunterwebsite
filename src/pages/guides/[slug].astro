---
import GuideArticle from '../../components/GuideArticle.astro';
import { GUIDES, guideBySlug } from '../../lib/guides';

export function getStaticPaths() {
  // Pillar guides with their own root path are rendered by their own page files.
  return GUIDES.filter((g) => !g.path).map((g) => ({ params: { slug: g.slug } }));
}

const g = guideBySlug(Astro.params.slug!);
---

<GuideArticle g={g} />

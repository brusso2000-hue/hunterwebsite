---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, GOOGLE_ADS_ID, GOOGLE_ADS_LABELS, GA4_ID, SNIPCART_PUBLIC_KEY, FORMSPREE_ENDPOINT } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  schema?: object[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.defaultDescription,
  image = '/img/og-image.jpg',
  ogType = 'website',
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.origin).href;
const ogImage = new URL(encodeURI(image), SITE.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ADS_ID}`}></script>
    <script is:inline define:vars={{ GOOGLE_ADS_ID, GOOGLE_ADS_LABELS, GA4_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', GOOGLE_ADS_ID, { allow_enhanced_conversions: true });

      // Fire a Google Ads conversion by name ('purchase' | 'lead' | 'call').
      // userData (email, name) feeds enhanced conversions; Google hashes it in the browser.
      window.hpConvert = function (name, params, userData) {
        try {
          var label = GOOGLE_ADS_LABELS[name];
          if (userData) gtag('set', 'user_data', userData);
          if (!label) return;
          gtag('event', 'conversion', Object.assign({ send_to: GOOGLE_ADS_ID + '/' + label }, params || {}));
        } catch (e) { /* tracking must never break the page */ }
      };

      // Keep the ad click ID (90 days) so a quote that turns into a PO weeks later
      // can be uploaded back to Google Ads as an offline conversion.
      (function () {
        try {
          var q = new URLSearchParams(location.search);
          ['gclid', 'gbraid', 'wbraid'].forEach(function (k) {
            var v = q.get(k);
            if (v) localStorage.setItem('hp_' + k, JSON.stringify({ v: v, t: Date.now() }));
          });
        } catch (e) {}
      })();
      window.hpClickId = function () {
        try {
          var keys = ['gclid', 'gbraid', 'wbraid'];
          for (var i = 0; i < keys.length; i++) {
            var raw = localStorage.getItem('hp_' + keys[i]);
            if (!raw) continue;
            var o = JSON.parse(raw);
            if (Date.now() - o.t < 90 * 864e5) return { type: keys[i], value: o.v, at: new Date(o.t).toISOString() };
          }
        } catch (e) {}
        return null;
      };

      // Phone taps are the main way shops reach us from a phone search.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[href^="tel:"]');
        if (a) window.hpConvert('call');
      });

      if (GA4_ID) gtag('config', GA4_ID);
    </script>

    <!-- Where did this visitor come from? Saved in the browser on arrival and attached to
         every form submission and Snipcart order. "first" = the visit that first brought
         them to the site; "last" = the most recent visit that came from somewhere trackable
         (an ad, a search, a link, a tagged email). Kept 180 days. -->
    <script is:inline>
      (function () {
        var MAX_AGE = 180 * 864e5;
        var SELF = location.hostname.replace(/^www\./, '');
        // Checkout and payment pages send people back here; they are not traffic sources.
        var IGNORE = /(^|\.)(hunterproducts\.com|snipcart\.com|stripe\.com|paypal\.com|squareup\.com|3dsecure\.io|cardinalcommerce\.com|arcot\.com)$/;

        function load(k) {
          try {
            var o = JSON.parse(localStorage.getItem(k) || 'null');
            if (o && Date.now() - o.t < MAX_AGE) return o;
          } catch (e) {}
          return null;
        }
        function save(k, o) { try { localStorage.setItem(k, JSON.stringify(o)); } catch (e) {} }
        function host(u) { try { return new URL(u).hostname.replace(/^www\./, '').toLowerCase(); } catch (e) { return ''; } }

        function classify(t) {
          var q = t.utm || {}, r = t.ref || '';
          var s = (q.source || '').toLowerCase(), m = (q.medium || '').toLowerCase();
          var camp = q.campaign ? ' (' + q.campaign + ')' : '';
          if (t.click === 'gclid' || t.click === 'gbraid' || t.click === 'wbraid') return 'Google Ads' + camp;
          if (t.click === 'msclkid') return 'Microsoft Ads' + camp;
          if (s) {
            var kind = /cpc|ppc|paid|display|banner/.test(m) ? 'Paid' : /e-?mail|newsletter/.test(m) ? 'Email' : /social/.test(m) ? 'Social' : 'Tagged link';
            return kind + ': ' + q.source + camp;
          }
          if (t.click === 'fbclid') return 'Social: Facebook/Instagram';
          if (!r) return 'Direct (typed URL, bookmark, or untagged link)';
          if (/(^|\.)google\.[a-z.]+$/.test(r)) return t.srsltid ? 'Organic search: Google (product listing)' : 'Organic search: Google';
          if (/(^|\.)bing\.com$/.test(r)) return 'Organic search: Bing';
          if (/(^|\.)(duckduckgo\.com|search\.yahoo\.com|yahoo\.com|ecosia\.org|search\.brave\.com|yandex\.[a-z]+|baidu\.com|naver\.com|daum\.net)$/.test(r)) return 'Organic search: ' + r;
          if (/thomasnet\.com$/.test(r)) return 'ThomasNet';
          if (/techbriefs\.com$|sae\.org$/.test(r)) return 'Tech Briefs';
          if (/chatgpt\.com$|openai\.com$|perplexity\.ai$|claude\.ai$|gemini\.google\.com$|copilot\.microsoft\.com$/.test(r)) return 'AI assistant: ' + r;
          if (/linkedin\.com$|lnkd\.in$/.test(r)) return 'Social: LinkedIn';
          if (/facebook\.com$|instagram\.com$|fb\.com$/.test(r)) return 'Social: Facebook/Instagram';
          if (/youtube\.com$|youtu\.be$/.test(r)) return 'Social: YouTube';
          if (/tiktok\.com$/.test(r)) return 'Social: TikTok';
          if (/reddit\.com$/.test(r)) return 'Social: Reddit';
          if (/(^|\.)(t\.co|x\.com|twitter\.com)$/.test(r)) return 'Social: X';
          if (/apollo\.io$/.test(r)) return 'Email: Apollo sequence';
          if (/mail\.google\.com$|outlook\.(live|office|office365)\.com$|mail\.yahoo\.com$/.test(r)) return 'Email link (' + r + ')';
          if (/amazon\.|ebay\./.test(r)) return 'Marketplace: ' + r;
          return 'Referral: ' + r;
        }

        try {
          var q = new URLSearchParams(location.search);
          var utm = {}, hasUtm = false;
          ['source', 'medium', 'campaign', 'term', 'content'].forEach(function (k) {
            var v = q.get('utm_' + k);
            if (v) { utm[k] = v.slice(0, 100); hasUtm = true; }
          });
          var click = null;
          ['gclid', 'gbraid', 'wbraid', 'msclkid', 'fbclid'].some(function (k) { return q.get(k) ? (click = k) : false; });
          var ref = host(document.referrer);
          if (ref === SELF || IGNORE.test(ref)) ref = '';

          var touch = {
            t: Date.now(),
            ref: ref,
            utm: hasUtm ? utm : null,
            click: click,
            srsltid: !!q.get('srsltid'),
            landing: location.pathname,
          };
          touch.channel = classify(touch);

          if (!load('hp_src_first')) save('hp_src_first', touch);
          // A new trackable arrival replaces "last". Moving between our own pages does not.
          if (ref || hasUtm || click || !load('hp_src_last')) save('hp_src_last', touch);

          var pv = Number(sessionStorage.getItem('hp_pv') || 0) + 1;
          sessionStorage.setItem('hp_pv', String(pv));
        } catch (e) { /* never break the page */ }

        function day(ts) { return new Date(ts).toISOString().slice(0, 10); }
        function utmText(u) {
          if (!u) return '';
          return Object.keys(u).map(function (k) { return k + '=' + u[k]; }).join(', ');
        }

        // Flat, human-readable fields for a Formspree email or Snipcart order metadata.
        window.hpSourceFields = function () {
          var out = {};
          try {
            var f = load('hp_src_first'), l = load('hp_src_last');
            if (!f) return out;
            var days = Math.floor((Date.now() - f.t) / 864e5);
            out.source = f.channel;
            out.source_landing_page = f.landing;
            out.source_referrer = f.ref || '(none)';
            if (f.utm) out.source_utm = utmText(f.utm);
            out.first_visit = day(f.t) + (days === 0 ? ' (today)' : ' (' + days + ' day' + (days === 1 ? '' : 's') + ' before)');
            if (l && l.t !== f.t) {
              out.latest_source = l.channel + ' on ' + day(l.t) + ', landed on ' + l.landing;
              if (l.utm) out.latest_utm = utmText(l.utm);
            }
            out.pages_this_visit = sessionStorage.getItem('hp_pv') || '1';
          } catch (e) {}
          return out;
        };
      })();
    </script>

    <!-- Apollo website visitor tracking -->
    <script is:inline>function initApollo(){var n=Math.random().toString(36).substring(7),o=document.createElement("script");o.src="https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache="+n,o.async=!0,o.defer=!0,o.onload=function(){window.trackingFunctions.onLoad({appId:"69b45679ef90270019029191"})},document.head.appendChild(o)}initApollo();</script>

    <!-- Snipcart → Google Ads purchase conversion. Snipcart v3 announces a placed order
         as 'cart.confirmed' (v2's 'order.completed' never fires on v3). -->
    <script is:inline define:vars={{ FORMSPREE_ENDPOINT }}>
      document.addEventListener('snipcart.ready', function () {
        if (typeof Snipcart === 'undefined') return;

        // Stamp the visitor's traffic source and saved ad click ID onto the cart so they
        // land on the order (Snipcart dashboard → order → Metadata). The click ID lets an
        // order be uploaded to Google Ads as an offline conversion if needed.
        function stampSource() {
          try {
            var add = typeof window.hpSourceFields === 'function' ? window.hpSourceFields() : {};
            var click = typeof window.hpClickId === 'function' ? window.hpClickId() : null;
            if (click) {
              add.google_click_id = click.type + '=' + click.value;
              add.google_click_time = click.at;
            }
            delete add.pages_this_visit; // changes every page; not worth a cart update
            if (!Object.keys(add).length) return;
            var cart = Snipcart.store.getState().cart || {};
            var meta = cart.metadata || {};
            var changed = Object.keys(add).some(function (k) { return meta[k] !== add[k]; });
            if (!changed) return;
            Snipcart.api.cart.update({ metadata: Object.assign({}, meta, add) }).catch(function () {});
          } catch (e) { /* never break the cart */ }
        }
        stampSource();
        Snipcart.events.on('item.added', stampSource);

        // Email the order's traffic source to the shop inbox (Snipcart's own order email
        // has no room for it). Sent through the same Formspree form as quote requests.
        function emailOrderSource(r) {
          try {
            var b = r.billingAddress || {};
            var src = typeof window.hpSourceFields === 'function' ? window.hpSourceFields() : {};
            var total = Number(r.total != null ? r.total : r.grandTotal) || 0;
            var order = r.invoiceNumber || r.token || '';
            var data = new FormData();
            data.set('_subject', 'Order ' + order + ' came from: ' + (src.source || 'unknown'));
            data.set('request_type', 'order_source');
            data.set('order', order);
            data.set('order_total', '$' + total.toFixed(2));
            data.set('customer', b.fullName || b.name || '');
            data.set('company', b.company || '');
            data.set('email', r.email || b.email || '');
            Object.keys(src).forEach(function (k) { data.set(k, src[k]); });
            if (!src.source) data.set('source', 'unknown (browser blocked storage or source was never saved)');
            var click = typeof window.hpClickId === 'function' ? window.hpClickId() : null;
            if (click) data.set('google_click_id', click.type + '=' + click.value);
            fetch(FORMSPREE_ENDPOINT, { method: 'POST', body: data, headers: { Accept: 'application/json' }, keepalive: true }).catch(function () {});
          } catch (e) { /* never break checkout */ }
        }

        Snipcart.events.on('cart.confirmed', function (r) {
          r = r || {};
          emailOrderSource(r);
          try {
            var b = r.billingAddress || {};
            var email = r.email || b.email;
            var total = Number(r.total != null ? r.total : r.grandTotal) || 0;
            window.hpConvert(
              'purchase',
              {
                value: total,
                currency: (r.currency || 'USD').toUpperCase(),
                transaction_id: r.invoiceNumber || r.token,
              },
              email ? { email: email, phone_number: b.phone || undefined } : null
            );
          } catch (e) { /* never break checkout */ }
        });
      });
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/img/brand/icon-192.png" />
    <link rel="apple-touch-icon" href="/img/brand/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="geo.region" content="US-NJ" />
    <meta name="geo.placename" content="Flemington, New Jersey" />

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <link rel="preconnect" href="https://cdn.snipcart.com" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline define:vars={{ SNIPCART_PUBLIC_KEY }}>
      window.SnipcartSettings = {
        publicApiKey: SNIPCART_PUBLIC_KEY,
        loadStrategy: 'on-user-interaction',
        modalStyle: 'side',
      };
    </script>
    <script is:inline>
      (()=>{var c,d;(d=(c=window.SnipcartSettings).version)!=null||(c.version="3.0");var s,S;(S=(s=window.SnipcartSettings).timeoutDuration)!=null||(s.timeoutDuration=2750);var l,p;(p=(l=window.SnipcartSettings).domain)!=null||(l.domain="cdn.snipcart.com");var w,u;(u=(w=window.SnipcartSettings).protocol)!=null||(w.protocol="https");var f=window.SnipcartSettings.version.includes("v3.0.0-ci")||window.SnipcartSettings.version!="3.0"&&window.SnipcartSettings.version.localeCompare("3.4.0",void 0,{numeric:!0,sensitivity:"base"})===-1,m=["focus","mouseover","touchmove","scroll","keydown"];window.LoadSnipcart=o;document.readyState==="loading"?document.addEventListener("DOMContentLoaded",r):r();function r(){window.SnipcartSettings.loadStrategy?window.SnipcartSettings.loadStrategy==="on-user-interaction"&&(m.forEach(t=>document.addEventListener(t,o)),setTimeout(o,window.SnipcartSettings.timeoutDuration)):o()}var a=!1;function o(){if(a)return;a=!0;let t=document.getElementsByTagName("head")[0],e=document.querySelector("#snipcart"),i=document.querySelector(`src[src^="${window.SnipcartSettings.protocol}://${window.SnipcartSettings.domain}"][src$="snipcart.js"]`),n=document.querySelector(`link[href^="${window.SnipcartSettings.protocol}://${window.SnipcartSettings.domain}"][href$="snipcart.css"]`);e||(e=document.createElement("div"),e.id="snipcart",e.setAttribute("hidden","true"),document.body.appendChild(e)),v(e),i||(i=document.createElement("script"),i.src=`${window.SnipcartSettings.protocol}://${window.SnipcartSettings.domain}/themes/v${window.SnipcartSettings.version}/default/snipcart.js`,i.async=!0,t.appendChild(i)),n||(n=document.createElement("link"),n.rel="stylesheet",n.type="text/css",n.href=`${window.SnipcartSettings.protocol}://${window.SnipcartSettings.domain}/themes/v${window.SnipcartSettings.version}/default/snipcart.css`,t.prepend(n)),m.forEach(g=>document.removeEventListener(g,o))}function v(t){!f||(t.dataset.apiKey=window.SnipcartSettings.publicApiKey,window.SnipcartSettings.addProductBehavior&&(t.dataset.configAddProductBehavior=window.SnipcartSettings.addProductBehavior),window.SnipcartSettings.modalStyle&&(t.dataset.configModalStyle=window.SnipcartSettings.modalStyle),window.SnipcartSettings.currency&&(t.dataset.currency=window.SnipcartSettings.currency),window.SnipcartSettings.templatesUrl&&(t.dataset.templatesUrl=window.SnipcartSettings.templatesUrl))}})();
    </script>
  </body>
</html>
